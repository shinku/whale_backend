# 登录 token；生产环境必须替换为至少 32 字节的随机值
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_SECONDS=7200

# 微信小程序登录
WX_APP_ID=wxd1759a13d5977a28
WX_APP_SECRET=replace-with-mini-program-app-secret

# 微信支付 API v3
WX_PAY_APP_ID=wxd1759a13d5977a28
WX_PAY_MCH_ID=replace-with-mch-id
WX_PAY_MCH_SERIAL_NO=replace-with-merchant-cert-serial
WX_PAY_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
WX_PAY_API_V3_KEY=replace-with-32-byte-api-v3-key
WX_PAY_NOTIFY_URL=https://api.whalepea.com/api/pay/wechat/notify/vip
WX_PAY_REFUND_NOTIFY_URL=https://api.whalepea.com/api/pay/wechat/notify/refund
WX_PAY_PLATFORM_CERT_PATH=./certs/platform_cert.pem
WX_PAY_PLATFORM_SERIAL_NO=replace-with-platform-cert-serial
